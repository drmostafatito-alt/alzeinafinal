{
  "name": "al-zeina-cloudflare-backend",
  "version": "2.0.0",
  "description": "AL-ZEINA Cloudflare Workers + Hono + D1 + R2 backend",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:generate": "wrangler d1 execute al-zeina-db --local --file=./migrations/0001_init.sql",
    "db:generate:remote": "wrangler d1 execute al-zeina-db --remote --file=./migrations/0001_init.sql",
    "db:seed:local": "wrangler d1 execute al-zeina-db --local --file=./migrations/0002_seed.sql",
    "db:seed:remote": "wrangler d1 execute al-zeina-db --remote --file=./migrations/0002_seed.sql",
    "tail": "wrangler tail",
    "test": "node --test"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "qrcode-generator": "^1.4.4"
  },
  "devDependencies": {
    "wrangler": "^3.95.0"
  }
}
