# Cloudflare Worker non-secret variables are normally configured in wrangler.toml or dashboard.
# Copy this only for local reference; do not commit real secrets.

# Required secret:
JWT_SECRET=replace-with-long-random-value

# Optional operational configuration:
CORS_ORIGINS=https://your-store.pages.dev,https://your-domain.com
ADMIN_EMAIL=admin@alzeina.com
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15

# ============ Email Authentication ============
# Provider (mailpit | resend | mailchannels | console). No keys hardcoded anywhere.
# - resend       → PRODUCTION default: HTTP API, free tier (100/day, 3000/month).
#                  Requires a verified sending domain in Resend + the secret below.
# - mailchannels → production alternative (free via the Cloudflare Workers partnership,
#                  requires a domain on Cloudflare with proper SPF/DNS) — no API key.
# - mailpit      → local development capture ONLY (see EMAIL_MAILPIT_URL). Never set this in production.
# - console      → development fallback, logs to/from/subject only (no links/tokens in logs).
# When EMAIL_PROVIDER is not set, production (ENVIRONMENT=production) defaults to resend,
# and local development defaults to mailpit.
EMAIL_PROVIDER=
EMAIL_MAILPIT_URL=http://127.0.0.1:8025
EMAIL_FROM=noreply@your-domain.com
EMAIL_FROM_NAME=AL ZEINA
# Optional Reply-To address shown to the recipient
EMAIL_REPLY_TO=support@your-domain.com

# Base URL used to build the reset link inside the email.
# REQUIRED IN PRODUCTION: must be the real public storefront URL — never localhost.
RESET_LINK_BASE_URL=https://your-store.pages.dev

# Reset token lifetime in minutes (default 60)
RESET_TOKEN_TTL_MINUTES=60

# Forgot-password per-IP rate limit (per Worker isolate; add Cloudflare rate limiting
# rules for production-grade protection)
FORGOT_RATE_MAX=5
FORGOT_RATE_WINDOW_MINUTES=15

# Production email secret (set via `wrangler secret put RESEND_API_KEY` — never commit)
# RESEND_API_KEY=

# Optional integrations remain stubs unless configured; no paid gateway is required:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
