# عنوان الـ API.
#
# التطوير المحلي: اتركه فارغاً — تستخدم الواجهة البروكسي (/api/v1 → VITE_PROXY_TARGET)
# المعرّف في vite.config.js.
#
# الإنتاج: لا تضبطه. تُبنى الواجهة تلقائياً على عنوان الـ Worker المطلق:
#   https://al-zeina-api.michiamo-tito.workers.dev/api/v1
# تُقبل قيمة VITE_API_URL في الإنتاج فقط إذا كانت مطلقة (https://…) — مثلاً عند
# استخدام نطاق مخصص للـ API. أي قيمة نسبية في الإنتاج تُتجاهل عمداً.
VITE_API_URL=

# عنوان الباك إند للبروكسي أثناء التطوير
VITE_PROXY_TARGET=http://localhost:5000

# بيانات تجريبية عند تعذّر الاتصال بالخادم — للتطوير فقط، اتركها false في الإنتاج
VITE_ENABLE_DEMO_DATA=false
